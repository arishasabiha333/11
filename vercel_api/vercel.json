{
  "version": 2,
  "functions": {
    "api/football.js":      { "maxDuration": 10 },
    "api/sync_firebase.js": { "maxDuration": 30 }
  },
  "routes": [
    { "src": "/api/sync_firebase(.*)", "dest": "/api/sync_firebase.js" },
    { "src": "/api/(.*)",              "dest": "/api/football.js" },
    { "src": "/(.*)",                  "dest": "/api/football.js" }
  ]
}